# Application
APP_NAME=NEXUS
APP_ENV=local
APP_URL=http://localhost:8000

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nexus
DB_USERNAME=nexus_user
DB_PASSWORD=nexus_password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# MinIO (S3-compatible storage)
AWS_ACCESS_KEY_ID=nexus_minio
AWS_SECRET_ACCESS_KEY=nexus_minio_password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=nexus-documents
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mail (Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@nexus.local

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
